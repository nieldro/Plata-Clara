# Copia este archivo a .env y cambia los valores. El archivo .env NUNCA se sube a Git.
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=finanzas

# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
# En producción es obligatoria (mínimo 32 caracteres): con ENVIRONMENT=production la API no arranca sin ella.
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# development | production
ENVIRONMENT=development

# Zona horaria para calcular «hoy» y «este mes» (nombre IANA). El servidor corre en UTC; sin esto,
# después de las 7 p. m. en Colombia la app creería que ya es el día siguiente.
TIMEZONE=America/Bogota
