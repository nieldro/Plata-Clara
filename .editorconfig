# https://editorconfig.org — la misma configuración en cualquier editor (VS Code, PyCharm, etc.)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false   # en Markdown dos espacios al final significan salto de línea

[Makefile]
indent_style = tab
